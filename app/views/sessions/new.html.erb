<h1>Вход в CoworkHub</h1>

<% if flash[:alert] %>
  <p style="color: red;"><%= flash[:alert] %></p>
<% end %>

<%= form_with url: login_path, method: :post, local: true do |f| %>
  <div>
    <%= f.label :email, "Email" %>
    <%= f.email_field :email, required: true, autofocus: true %>
  </div>
  <div>
    <%= f.label :password, "Пароль" %>
    <%= f.password_field :password, required: true %>
  </div>
  <div>
    <%= f.submit "Войти" %>
  </div>
<% end %>

<p>Нет аккаунта? <%= link_to "Зарегистрироваться", signup_path %></p>